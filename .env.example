# Copier ce fichier en ".env" et renseigner les clés dont vous disposez.
# Une clé laissée VIDE (ou la ligne supprimée) = provider considéré comme
# non configuré et automatiquement ignoré par le fallback. N'utilisez jamais
# une valeur placeholder du type "..." : ce serait interprété comme une
# clé réelle (donc "configurée") mais invalide.

# --- Base vectorielle Chroma Cloud (https://www.trychroma.com/) ---
# CHROMA_API_KEY est obligatoire. CHROMA_TENANT/CHROMA_DATABASE peuvent être
# omis SEULEMENT si la clé API est déjà limitée à une seule base sur Chroma
# Cloud (résolution automatique par le SDK) ; sinon (ChromaAuthError:
# "Could not determine a database name...") renseignez-les explicitement.
# Pour les trouver : GET https://api.trychroma.com/api/v2/auth/identity
# avec le header "x-chroma-token: <CHROMA_API_KEY>" renvoie le tenant ; si
# aucune base n'existe encore, la créer via POST .../tenants/<tenant>/databases.
# CHROMA_COLLECTION_NAME doit être dédiée à l'espace vectoriel des embeddings
# actifs (E5 768 dim) : ne jamais réutiliser une collection remplie avec un
# autre modèle d'embedding (les distances/similarités ne seraient plus
# comparables, même si la dimension coïncidait par hasard).

CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION_NAME=portfolio_rag_e5

# --- Embeddings : modèle E5 multilingue local (aucune clé requise) ---
# Valeurs par défaut déjà correctes ; à ne changer que pour tester un autre
# modèle E5 (dans ce cas, utiliser aussi une AUTRE collection Chroma Cloud).
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-base
EMBEDDING_MODEL_VERSION=1
EMBEDDING_DEVICE=cpu

# --- Source de vérité : chemin local vers translations.js (facultatif) ---
# Utilisé uniquement pour l'initialisation automatique au démarrage si ce
# fichier est accessible depuis le backend. En production/Docker, laissez
# vide : le contenu est alors géré exclusivement via POST /upload-content.
TRANSLATIONS_JS_PATH=

# --- Sécurité de /upload-content ---
# Si vide : endpoint ouvert (dev local uniquement, un avertissement est
# loggé au démarrage). En production, définir un token fort ici ET dans le
# secret CI/CD (jamais dans le frontend) : /upload-content exigera alors
# "Authorization: Bearer <ce token>".
CONTENT_UPLOAD_TOKEN=

# --- Génération : ordre de fallback strict Gemini -> Mistral -> Groq -> OpenAI ---

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Divers (valeurs par défaut raisonnables, à ajuster si besoin) ---

LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
RETRIEVAL_TOP_K=8
